# DeepSeek（OpenAI 兼容协议）。key 只存本地，绝不提交/打印。
LLM_API_KEY=sk-在这里填入你的_deepseek_key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
MAX_STEPS=40
# Tesseract OCR（读视频/截图画面字幕）。chi_sim 已放在 tessdata/ 目录。
TESSDATA_DIR=./tessdata
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
